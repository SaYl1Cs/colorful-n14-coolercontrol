+#[cfg(test)]
+mod provenance_tests {
+    use super::*;
+    use prost::Message;
+    fn service(command: &str, provenance: bool) -> CustomDeviceService {
+        let key = if provenance {
+            "set_duty_provenance"
+        } else {
+            "set_duty"
+        };
+        let config = serde_json::from_value(serde_json::json!({"devices":[{
+            "id":"d", "label":"test", "channels":[{"id":"fan", "label":"fan", "commands":{key:command}}], "temps":[]
+        }]})).unwrap();
+        CustomDeviceService {
+            config,
+            devices: vec![],
+        }
+    }
+    fn request(label: &str, duty: i32) -> Request<FixedDutyRequest> {
+        let message = FixedDutyRequest {
+            device_id: "d".into(),
+            channel_id: "fan".into(),
+            duty,
+            provenance_json: label.into(),
+        };
+        // Exercise actual generated protobuf encoding/decoding, not a mock field bag.
+        Request::new(FixedDutyRequest::decode(message.encode_to_vec().as_slice()).unwrap())
+    }
+    #[tokio::test]
+    async fn protobuf_to_command_preserves_literal_json() {
+        let path = std::env::temp_dir().join(format!("n14-plugin-argv-{}", std::process::id()));
+        let command = format!(
+            "sh -c 'test \"$#\" = 2 && test \"$1\" = 42 && printf %s \"$2\" > \"$0\"' {}",
+            path.display()
+        );
+        let label = r#"{"schema":1,"profile":"' $(exit 9) \" \n","generation":7}"#;
+        service(&command, true)
+            .fixed_duty(request(label, 42))
+            .await
+            .unwrap();
+        assert_eq!(std::fs::read_to_string(&path).unwrap(), label);
+        std::fs::remove_file(path).unwrap();
+    }
+    #[tokio::test]
+    async fn errors_are_rpc_errors_and_missing_provenance_never_downgrades() {
+        let svc = service("exit 9", true);
+        assert_eq!(
+            svc.fixed_duty(request("{}", 42)).await.unwrap_err().code(),
+            tonic::Code::Internal
+        );
+        assert_eq!(
+            svc.fixed_duty(request("", 42)).await.unwrap_err().code(),
+            tonic::Code::FailedPrecondition
+        );
+        assert_eq!(
+            svc.fixed_duty(request("not json", 42))
+                .await
+                .unwrap_err()
+                .code(),
+            tonic::Code::InvalidArgument
+        );
+        assert_eq!(
+            svc.fixed_duty(request("[]", 42)).await.unwrap_err().code(),
+            tonic::Code::InvalidArgument
+        );
+        assert_eq!(
+            svc.fixed_duty(request("{}", 101)).await.unwrap_err().code(),
+            tonic::Code::InvalidArgument
+        );
+        assert_eq!(
+            service("exit 8", false)
+                .fixed_duty(request("", 42))
+                .await
+                .unwrap_err()
+                .code(),
+            tonic::Code::Internal
+        );
+        assert!(
+            service("true", false)
+                .fixed_duty(request("", 42))
+                .await
+                .is_ok()
+        );
+    }
