+/// `cmd` is trusted configuration, but duty/provenance are data, never shell code.
+/// The configured command receives exactly two appended arguments. Use a simple
+/// executable plus fixed arguments (e.g. adapter set-duty-provenance), not pipelines.
+pub async fn run_provenance_command(cmd: &str, duty: i32, provenance: &str) -> anyhow::Result<()> {
+    let output = Command::new("sh")
+        .arg("-c")
+        .arg(format!("{cmd} \"$1\" \"$2\""))
+        .arg("coolercontrol-provenance")
+        .arg(duty.to_string())
+        .arg(provenance)
+        .kill_on_drop(true)
+        .output()
+        .await?;
+    anyhow::ensure!(
+        output.status.success(),
+        "command exited with {}",
+        output.status
+    );
+    Ok(())
+}
