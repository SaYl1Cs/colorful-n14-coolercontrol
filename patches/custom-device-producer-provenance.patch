+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn producer_sample_is_not_retimestamped_or_coerced() {
+        let (temp, sample) = parse_sample(r#"{"temperature":63.25,"sample":{"session":"s","generation":3,"sample_id":9,"sampled_at_unix_ms":123}}"#).unwrap();
+        assert_eq!(temp, 63.25);
+        let value: serde_json::Value = serde_json::from_str(&sample).unwrap();
+        assert_eq!(value["sampled_at_unix_ms"], 123);
+        assert_eq!(value["sample_id"], 9);
+        assert!(parse_sample("63000").is_err());
+        assert!(parse_sample(r#"{"temperature":63,"sample":null}"#).is_err());
+        assert!(parse_sample(r#"{"temperature":null,"sample":{}}"#).is_err());
+        assert!(parse_sample(r#"{"temperature":1e999,"sample":{}}"#).is_err());
+        assert!(
+            parse_sample(&format!(
+                "{{\"temperature\":63,\"sample\":{{\"padding\":\"{}\"}}}}",
+                "x".repeat(16384)
+            ))
+            .is_err()
+        );
+    }
+
+    #[tokio::test]
+    async fn producer_sample_command_to_status_protobuf_preserves_complete_metadata() {
+        use prost::Message;
+        let sample = serde_json::json!({
+            "session": "test-sampler", "generation": 7, "sample_id": 101,
+            "sampled_at_unix_ms": 123, "sampled_at_monotonic_ns": 456,
+            "sensor": "cpu", "power_state": "active", "extension": {"keep": true},
+        });
+        let payload = serde_json::json!({"temperature": 63.25, "sample": sample});
+        let mut device: CustomDevice = serde_json::from_value(serde_json::json!({
+            "id": "device", "label": "test", "channels": [],
+            "temps": [{"id": "cpu", "label": "CPU", "provenance": true,
+                "command": format!("printf '%s' '{}'", payload)}],
+        }))
+        .unwrap();
+        for _ in 0..2 {
+            let statuses = poll_device_status(&device).await;
+            assert_eq!(statuses.len(), 1);
+            let status =
+                models::v1::Status::decode(statuses[0].encode_to_vec().as_slice()).unwrap();
+            assert_eq!(status.id, "cpu");
+            assert_eq!(status.metric, Some(models::v1::status::Metric::Temp(63.25)));
+            let transported: serde_json::Value =
+                serde_json::from_str(&status.sample_provenance_json).unwrap();
+            assert_eq!(transported, sample);
+        }
+        for command in ["printf 63000", "printf '{}'", "exit 1"] {
+            device.temps[0].command = command.to_owned();
+            assert!(poll_device_status(&device).await.is_empty());
+        }
+        // The old numeric path remains opt-in by absence of provenance, with no
+        // manufactured sample identity even when a numeric value is available.
+        device.temps[0].provenance = false;
+        device.temps[0].command = "printf 63000".to_owned();
+        let statuses = poll_device_status(&device).await;
+        assert_eq!(statuses.len(), 1);
+        assert_eq!(
+            statuses[0].metric,
+            Some(models::v1::status::Metric::Temp(63.0))
+        );
+        assert!(statuses[0].sample_provenance_json.is_empty());
+    }
+
+    #[tokio::test]
+    async fn provenance_is_one_literal_argument_and_failure_propagates() {
+        let json = r#"{"profile":"' ; $(exit 91) \" \n", "generation":4}"#;
+        // Nested shell asserts that neither expansion nor word splitting occurred.
+        run_provenance_command(
+            "sh -c 'test \"$#\" = 2 && test \"$1\" = 42 && test -n \"$2\"' check",
+            42,
+            json,
+        )
+        .await
+        .unwrap();
+        assert!(
+            run_provenance_command("sh -c 'exit 7' check", 42, json)
+                .await
+                .is_err()
+        );
+        assert!(
+            run_provenance_command("/nonexistent/n14-provenance-test", 42, json)
+                .await
+                .is_err()
+        );
+    }
+}
+
+fn parse_sample(out: &str) -> anyhow::Result<(f64, String)> {
+    anyhow::ensure!(out.len() <= 16384, "sample too large");
+    let value: serde_json::Value = serde_json::from_str(out)?;
+    let temperature = value["temperature"]
+        .as_f64()
+        .ok_or_else(|| anyhow::anyhow!("temperature missing"))?;
+    anyhow::ensure!(temperature.is_finite(), "nonfinite temperature");
+    anyhow::ensure!(value["sample"].is_object(), "sample object missing");
+    Ok((temperature, value["sample"].to_string()))
+}
