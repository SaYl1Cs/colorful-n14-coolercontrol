+    #[test]
+    #[serial]
+    fn producer_queue_retains_assignment_and_original_sample() {
+        cc_fs::test_runtime(async {
+            let h = setup_harness();
+            let fan = create_controllable_fan(&h.device, "fan1");
+            let temp = create_temp(&h.device, "temp1");
+            let uid = h.device.borrow().uid.clone();
+            let profile = create_graph_profile_with_temp_source(
+                &h.config,
+                vec![(30., 40), (70., 80)],
+                TempSource {
+                    device_uid: uid.clone(),
+                    temp_name: temp.clone(),
+                },
+            );
+            h.engine.set_profile(&uid, &fan, &profile).await.unwrap();
+            let old_assignment = h.engine.producer_assignment(&uid, &fan);
+            let result = moro_local::async_scope!(|scope| {
+                set_temp_status(&h.device, &temp, 30.);
+                {
+                    let mut device = h.device.borrow_mut();
+                    let timestamp = device.status_history.back().unwrap().timestamp;
+                    device.source_samples.push_back((timestamp, HashMap::from([(temp.clone(),
+                        serde_json::json!({"session":"sampler-A", "generation":7,"sample_id":101,"sampled_at_unix_ms":123}).to_string())])));
+                }
+                h.engine.process_scheduled_speeds(scope);
+                // The first task has been queued but has not run. Reassign the same profile.
+                h.engine.set_profile(&uid, &fan, &profile).await.unwrap();
+                set_temp_status(&h.device, &temp, 70.);
+                h.engine.process_scheduled_speeds(scope);
+                Ok(())
+            }).await;
+            assert!(result.is_ok());
+            let labels: Vec<serde_json::Value> = h
+                .provenance
+                .borrow()
+                .iter()
+                .map(|s| serde_json::from_str(s).unwrap())
+                .collect();
+            assert_eq!(labels.len(), 2);
+            let old = labels
+                .iter()
+                .find(|l| l["calculation"]["duty"] == 40)
+                .unwrap();
+            let new = labels
+                .iter()
+                .find(|l| l["calculation"]["duty"] == 80)
+                .unwrap();
+            assert_eq!(old["assignment"], old_assignment["assignment"]);
+            assert_ne!(
+                old["assignment"]["generation"],
+                new["assignment"]["generation"]
+            );
+            assert_eq!(
+                old["calculation"]["inputs"]["status_observations_newest_first"][0]["sensor_sample"]
+                    ["sample_id"],
+                101
+            );
+            assert!(new["calculation"]["inputs"]["status_observations_newest_first"][0]["sensor_sample"].is_null());
+            assert_eq!(
+                old["calculation"]["inputs"]["sensor_sample"],
+                old["calculation"]["inputs"]["status_observations_newest_first"][0]["sensor_sample"]
+            );
+            // An older sample in history must not fill in for a missing newest sample.
+            assert!(new["calculation"]["inputs"]["sensor_sample"].is_null());
+        });
+    }
