+// SPDX-License-Identifier: GPL-3.0-or-later
+
+//! Immutable calculation labels for software Graph and Mix commands.
+//!
+//! The counter orders assignments and calculations even within one clock tick.
+//! Wall-clock timestamps are observations, not a freshness policy. In particular,
+//! retained Mix members and sensor metadata must never be re-stamped here.
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::rc::Rc;
+
+use anyhow::Result;
+use async_trait::async_trait;
+use chrono::Utc;
+use serde::Serialize;
+use serde_json::{Value, json};
+use uuid::Uuid;
+
+use crate::calibration::DutyWriter;
+use crate::device::{Duty, UID};
+
+#[derive(Clone, Serialize)]
+struct Assignment {
+    generation: u64,
+    profile_uid: String,
+    assigned_at_unix_ms: i64,
+}
+
+/// One producer session per engine instance. Never clone or restore its counter.
+/// This is main-thread state, just like the commanders that own it.
+pub struct Producer {
+    session: String,
+    counter: Cell<u64>,
+    assignments: RefCell<HashMap<(String, String), Assignment>>,
+}
+
+impl Producer {
+    pub fn new() -> Self {
+        Self {
+            session: Uuid::new_v4().to_string(),
+            counter: Cell::new(0),
+            assignments: RefCell::new(HashMap::new()),
+        }
+    }
+
+    fn next_id(&self) -> u64 {
+        // Exhaustion must stop production, never wrap and reuse an identity.
+        let next = self
+            .counter
+            .get()
+            .checked_add(1)
+            .expect("producer identity counter exhausted");
+        self.counter.set(next);
+        next
+    }
+
+    pub fn bind(&self, device: &str, channel: &str, profile: &str) {
+        let assignment = Assignment {
+            generation: self.next_id(),
+            profile_uid: profile.to_owned(),
+            assigned_at_unix_ms: Utc::now().timestamp_millis(),
+        };
+        self.assignments
+            .borrow_mut()
+            .insert((device.to_owned(), channel.to_owned()), assignment);
+    }
+
+    pub fn clear(&self, device: &str, channel: &str) {
+        self.assignments
+            .borrow_mut()
+            .remove(&(device.to_owned(), channel.to_owned()));
+    }
+
+    pub fn profile(&self, device: &str, channel: &str) -> Option<String> {
+        self.assignments
+            .borrow()
+            .get(&(device.to_owned(), channel.to_owned()))
+            .map(|assignment| assignment.profile_uid.clone())
+    }
+
+    pub fn assignment(&self, device: &str, channel: &str) -> Option<Value> {
+        let assignments = self.assignments.borrow();
+        let assignment = assignments.get(&(device.to_owned(), channel.to_owned()))?;
+        Some(json!({
+            "schema": 1,
+            "producer_session": self.session,
+            "device_uid": device,
+            "channel_name": channel,
+            "assignment": assignment,
+        }))
+    }
+
+    pub fn calculation(&self, profile: &str, duty: Duty, inputs: Value) -> Value {
+        json!({
+            "calculation_id": self.next_id(),
+            "calculated_at_unix_ms": Utc::now().timestamp_millis(),
+            "profile_uid": profile,
+            "duty": duty,
+            "inputs": inputs,
+        })
+    }
+
+    /// Serialize before queueing. Never attach a calculation that predates the
+    /// current assignment, even if its profile and millisecond timestamp match.
+    pub fn label(&self, device: &str, channel: &str, calculation: &Value) -> Option<String> {
+        let mut envelope = self.assignment(device, channel)?;
+        let assignment = &envelope["assignment"];
+        let id = calculation["calculation_id"].as_u64()?;
+        if calculation["profile_uid"] != assignment["profile_uid"]
+            || id <= assignment["generation"].as_u64()?
+            || id > self.counter.get()
+            || calculation["calculated_at_unix_ms"].as_i64()?
+                < assignment["assigned_at_unix_ms"].as_i64()?
+            || calculation["duty"].as_u64()? > 100
+            || !calculation["inputs"].is_object()
+        {
+            return None;
+        }
+        envelope["calculation"] = calculation.clone();
+        Some(envelope.to_string())
+    }
+}
+
+/// A queued write owns its original bytes. There is deliberately no reference
+/// to the producer or its mutable assignment map at the dispatch boundary.
+pub struct LabeledWriter {
+    inner: Rc<dyn DutyWriter>,
+    label: String,
+}
+
+impl LabeledWriter {
+    pub fn bind(inner: Rc<dyn DutyWriter>, label: String) -> Rc<dyn DutyWriter> {
+        Rc::new(Self { inner, label })
+    }
+}
+
+#[async_trait(?Send)]
+impl DutyWriter for LabeledWriter {
+    async fn write_device_duty(
+        &self,
+        device_uid: &UID,
+        channel_name: &str,
+        device_duty: Duty,
+    ) -> Result<()> {
+        self.inner
+            .write_device_duty_provenance(device_uid, channel_name, device_duty, &self.label)
+            .await
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn producer_sessions_and_assignment_envelopes() {
+        let producer = Producer::new();
+        let other = Producer::new();
+        assert_ne!(producer.session, other.session);
+        assert_eq!(
+            Uuid::parse_str(&producer.session)
+                .unwrap()
+                .get_version_num(),
+            4
+        );
+        assert!(producer.assignment("device", "fan").is_none());
+        let before = Utc::now().timestamp_millis();
+        producer.bind("device", "fan", "graph");
+        let envelope = producer.assignment("device", "fan").unwrap();
+        assert_eq!(envelope["schema"], 1);
+        assert_eq!(envelope["producer_session"], producer.session);
+        assert_eq!(envelope["device_uid"], "device");
+        assert_eq!(envelope["channel_name"], "fan");
+        assert_eq!(envelope["assignment"]["profile_uid"], "graph");
+        assert_eq!(envelope["assignment"]["generation"], 1);
+        assert!(
+            envelope["assignment"]["assigned_at_unix_ms"]
+                .as_i64()
+                .unwrap()
+                >= before
+        );
+        assert!(envelope.get("calculation").is_none());
+    }
+
+    #[test]
+    fn producer_reassignment_rejects_old_calculations_without_relabeling_queued_bytes() {
+        let producer = Producer::new();
+        producer.bind("device", "fan", "graph");
+        let old_assignment = producer.assignment("device", "fan").unwrap();
+        let old = producer.calculation("graph", 42, json!({"kind": "graph"}));
+        let queued = producer.label("device", "fan", &old).unwrap();
+        producer.bind("device", "fan", "graph");
+        assert!(producer.label("device", "fan", &old).is_none());
+        let new = producer.calculation("graph", 43, json!({"kind": "graph"}));
+        let new_label: Value =
+            serde_json::from_str(&producer.label("device", "fan", &new).unwrap()).unwrap();
+        let old_label: Value = serde_json::from_str(&queued).unwrap();
+        assert_eq!(old_label["assignment"], old_assignment["assignment"]);
+        assert_eq!(old_label["calculation"], old);
+        assert_eq!(old["calculation_id"], 2);
+        assert_eq!(new_label["assignment"]["generation"], 3);
+        assert_eq!(new["calculation_id"], 4);
+    }
+
+    #[test]
+    fn producer_channel_isolation_clear_and_profile_mismatch() {
+        let producer = Producer::new();
+        producer.bind("device", "fan1", "graph");
+        producer.bind("device", "fan2", "mix");
+        producer.bind("other", "fan1", "graph");
+        let calc = producer.calculation("graph", 42, json!({"kind": "graph"}));
+        assert!(producer.label("device", "fan2", &calc).is_none());
+        assert!(producer.label("missing", "fan1", &calc).is_none());
+        producer.clear("device", "fan1");
+        assert!(producer.profile("device", "fan1").is_none());
+        assert!(producer.label("device", "fan1", &calc).is_none());
+        assert_eq!(producer.profile("device", "fan2").as_deref(), Some("mix"));
+        assert!(producer.label("other", "fan1", &calc).is_some());
+        producer.bind("device", "fan1", "graph");
+        assert!(producer.label("device", "fan1", &calc).is_none());
+    }
+
+    #[test]
+    fn producer_preserves_nested_retained_and_unknown_inputs() {
+        let producer = Producer::new();
+        let child = producer.calculation("graph", 42, json!({
+            "kind": "graph",
+            "sensor_sample": {"session": "sampler", "sampled_at_unix_ms": 123, "sample_id": 9},
+            "status_observations_newest_first": [{"temperature": 63.0, "status_unix_ms": 456, "sensor_sample": null}],
+        }));
+        producer.bind("device", "fan", "mix");
+        let inputs = json!({"kind": "mix", "members": [
+            {"profile_uid": "graph", "kind": "calculated", "retained": true, "calculation": child},
+            {"profile_uid": "unknown", "kind": "calculated", "retained": true, "calculation": null},
+            {"profile_uid": "fixed", "kind": "fixed", "duty": 50},
+        ]});
+        let calc = producer.calculation("mix", 50, inputs.clone());
+        let label: Value =
+            serde_json::from_str(&producer.label("device", "fan", &calc).unwrap()).unwrap();
+        assert_eq!(label["calculation"]["inputs"], inputs);
+        assert_eq!(
+            label["calculation"]["inputs"]["members"][0]["calculation"],
+            child
+        );
+    }
+
+    #[test]
+    fn producer_rejects_invalid_calculation_identity_and_clock_regression() {
+        let producer = Producer::new();
+        producer.bind("device", "fan", "graph");
+        let calc = producer.calculation("graph", 42, json!({"kind": "graph"}));
+        for (field, value) in [
+            ("calculation_id", json!(0)),
+            ("calculation_id", json!(u64::MAX)),
+            ("calculated_at_unix_ms", json!(0)),
+            ("calculated_at_unix_ms", Value::Null),
+            ("duty", json!(101)),
+            ("duty", json!(-1)),
+            ("inputs", Value::Null),
+        ] {
+            let mut invalid = calc.clone();
+            invalid[field] = value;
+            assert!(
+                producer.label("device", "fan", &invalid).is_none(),
+                "{field}"
+            );
+        }
+    }
+
+    #[test]
+    #[should_panic(expected = "producer identity counter exhausted")]
+    fn producer_counter_does_not_wrap() {
+        let producer = Producer::new();
+        producer.counter.set(u64::MAX);
+        producer.bind("device", "fan", "graph");
+    }
+
+    #[derive(Default)]
+    struct RecordingWriter {
+        writes: RefCell<Vec<(UID, String, Duty, String)>>,
+        fail: Cell<bool>,
+    }
+
+    #[async_trait(?Send)]
+    impl DutyWriter for RecordingWriter {
+        async fn write_device_duty(&self, _: &UID, _: &str, _: Duty) -> Result<()> {
+            panic!("label must not be downgraded to an ordinary write");
+        }
+
+        async fn write_device_duty_provenance(
+            &self,
+            device: &UID,
+            channel: &str,
+            duty: Duty,
+            label: &str,
+        ) -> Result<()> {
+            self.writes.borrow_mut().push((
+                device.clone(),
+                channel.to_owned(),
+                duty,
+                label.to_owned(),
+            ));
+            anyhow::ensure!(!self.fail.get(), "write failed");
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn producer_labeled_writer_preserves_bytes_and_propagates_failures() {
+        crate::cc_fs::test_runtime(async {
+            let producer = Producer::new();
+            producer.bind("device", "fan", "graph");
+            let calc = producer.calculation("graph", 42, json!({"kind": "graph"}));
+            let label = producer.label("device", "fan", &calc).unwrap();
+            let inner = Rc::new(RecordingWriter::default());
+            let writer = LabeledWriter::bind(inner.clone(), label.clone());
+            producer.bind("device", "fan", "different");
+            writer
+                .write_device_duty(&"device".to_owned(), "fan", 42)
+                .await
+                .unwrap();
+            inner.fail.set(true);
+            assert!(
+                writer
+                    .write_device_duty(&"device".to_owned(), "fan", 42)
+                    .await
+                    .is_err()
+            );
+            assert_eq!(
+                *inner.writes.borrow(),
+                vec![
+                    ("device".into(), "fan".into(), 42, label.clone()),
+                    ("device".into(), "fan".into(), 42, label),
+                ]
+            );
+        });
+    }
+}
