+            }
+            let calculation = &command["calculation"];
+            assert_eq!(calculation["profile_uid"], profile);
+            assert_eq!(calculation["duty"], 42);
+            assert_eq!(*h.set_speeds.borrow(), vec![42]);
+            assert!(
+                calculation["calculation_id"].as_u64().unwrap()
+                    > assignment["assignment"]["generation"].as_u64().unwrap()
+            );
+            let inputs = &calculation["inputs"];
