+            assert_eq!(inputs["source_temp_name"], temp);
+            assert_eq!(inputs["sensor_sample"], sample);
+            let observation = &inputs["status_observations_newest_first"][0];
+            assert_eq!(observation["sensor_sample"], sample);
+            assert_eq!(observation["temperature"], 63.);
+            assert_eq!(observation["status_unix_ms"], timestamp.timestamp_millis());
