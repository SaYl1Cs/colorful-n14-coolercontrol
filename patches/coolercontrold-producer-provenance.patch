+                "sampled_at_unix_ms": chrono::Utc::now().timestamp_millis(),
+                "sampled_at_monotonic_ns": 123456789, "sensor": "cpu", "power_state": "active",
+                "extension": {"preserve": [1, "literal", null]},
+            });
+            let timestamp = {
+                let mut device = h.device.borrow_mut();
+                let timestamp = device.status_history.back().unwrap().timestamp;
+                device.source_samples.push_back((
+                    timestamp,
+                    HashMap::from([(temp.clone(), sample.to_string())]),
