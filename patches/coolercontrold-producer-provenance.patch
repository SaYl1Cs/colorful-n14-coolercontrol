+                .unwrap();
+            h.engine.set_profile(&uid, &fan, &mix).await.unwrap();
+            for gpu_temp in [30., 70.] {
+                set_two_temp_status(&h.device, &cpu, 30., &gpu, gpu_temp);
+                moro_local::async_scope!(|scope| {
+                    h.engine.process_scheduled_speeds(scope);
+                    Ok(())
+                })
+                .await
+                .unwrap();
+            }
+            let labels: Vec<serde_json::Value> = h
+                .provenance
+                .borrow()
+                .iter()
+                .map(|s| serde_json::from_str(s).unwrap())
+                .collect();
+            assert_eq!(labels.len(), 2);
+            let member = |i: usize| {
+                labels[i]["calculation"]["inputs"]["members"]
+                    .as_array()
+                    .unwrap()
+                    .iter()
+                    .find(|m| m["profile_uid"] == cpu_profile)
+                    .unwrap()
+            };
+            assert_eq!(member(0)["retained"], false);
+            assert_eq!(member(1)["retained"], true);
+            assert_eq!(member(0)["calculation"], member(1)["calculation"]);
+            assert_ne!(
+                labels[0]["calculation"]["calculation_id"],
+                labels[1]["calculation"]["calculation_id"]
+            );
+            assert_eq!(labels[0]["assignment"], labels[1]["assignment"]);
+        });
