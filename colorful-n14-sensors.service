[Unit]
Description=Read-only EC CPU/GPU snapshot sampler for Colorful N14
Requires=colorful-n14-nbfc-prepare.service
After=colorful-n14-nbfc-prepare.service
Before=coolercontrold.service

[Service]
Type=notify
ExecStart=/usr/bin/python3 -B /usr/local/share/colorful-n14-control/sensor_cache.py
ExecStopPost=/usr/bin/rm -f /run/colorful-n14-control/temperatures.json /run/colorful-n14-control/cpu_temp /run/colorful-n14-control/gpu_temp
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/colorful-n14-control
# Temperature access is read-only ec0/io; PCI runtime/power state is sysfs-only.

[Install]
WantedBy=multi-user.target
