# Python environments and generated output.
__pycache__/
*.py[cod]
.venv/
*.log
*.zip
runtime/
test-results.txt
/build/
/dist/
target/
node_modules/
*.o
*.a
*.so
*.so.*

# Local authorization, private bindings, snapshots and exported conversations.
.env
.env.*
!.env.example
coolercontrol-token.json
profile-bindings.json
*.pem
*.key
*.p12
*.pfx
/credentials/
/secrets/
